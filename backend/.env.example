# KickzStore Backend Environment Variables Template
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/KickzStore_dev
DBNAME=KickzStore_dev
JWT_SECRET=your_jwt_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
SERPAPI_KEY=your_serpapi_key_here
